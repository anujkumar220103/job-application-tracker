# Copy this file to .env and fill in real values. Never commit the real .env.

# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://neondb_owner:npg_tWuwJz7Mh9GY@ep-winter-king-adei9v9g-pooler.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Secret used to sign JWTs. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=supersecretkey123

# Optional: only set when the frontend should call a separately deployed API.
# When omitted, the app uses its built-in same-origin /api routes.
NEXT_PUBLIC_API_URL="/api"

# Node environment (development | production | test)
NODE_ENV="development"

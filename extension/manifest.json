{
  "manifest_version": 3,
  "name": "Job Tracker Auto Logger",
  "version": "1.1",
  "description": "Automatically logs your job applications to your Job Tracker.",

  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],

  "host_permissions": [
    "*://*.linkedin.com/*",
    "*://*.unstop.com/*",
    "*://*.internshala.com/*",
    "http://localhost:5000/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.unstop.com/*",
        "*://*.internshala.com/*"
      ],
      "js": ["lib/jobTracker.core.js", "content.js"]
    },
    {
      "matches": ["http://localhost:3000/*"],
      "js": ["saveToken.js"]
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icon.png"
  }
}

# Backend environment configuration.
# Copy this file to backend/.env and fill in real values. Never commit the real .env.
#
# These are BACKEND-ONLY secrets. They must never be exposed to the frontend
# or placed in any NEXT_PUBLIC_* variable.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Secret used to sign JWTs. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

# Port the Express API server listens on (development default: 5000).
PORT=5000

# Comma-separated list of allowed frontend origins for CORS.
# Development default is the Next.js dev server. In production, set this to your
# deployed frontend origin(s) — do NOT rely on localhost.
CORS_ORIGIN=http://localhost:3000

# Node environment (development | production | test)
NODE_ENV=development

  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "prisma": "^7.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5",
